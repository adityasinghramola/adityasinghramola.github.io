---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';
import { getProjects, formatDate } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: { project, newer: projects[i - 1], older: projects[i + 1] },
  }));
}

const { project, newer, older } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={data.title} description={data.summary}>
  <article class="wrap">
    <header class="head">
      <a class="back" href="/">All projects</a>
      <h1>{data.title}</h1>
      <div class="answer">
        <h2>{data.status === 'done' ? 'Short answer' : 'Where it stands'}</h2>
        <p>{data.summary}</p>
      </div>
    </header>

    <div class="body">
      <aside class="facts" aria-label="Project details">
        <dl>
          <div>
            <dt>Status</dt>
            <dd><Status status={data.status} /></dd>
          </div>
          <div>
            <dt>Started</dt>
            <dd><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time></dd>
          </div>
          {
            data.updated && (
              <div>
                <dt>Updated</dt>
                <dd>
                  <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time>
                </dd>
              </div>
            )
          }
          {
            data.topics.length > 0 && (
              <div>
                <dt>Topics</dt>
                <dd>{data.topics.join(', ')}</dd>
              </div>
            )
          }
          {
            data.tools.length > 0 && (
              <div>
                <dt>Tools</dt>
                <dd>{data.tools.join(', ')}</dd>
              </div>
            )
          }
          {
            data.links.length > 0 && (
              <div>
                <dt>Links</dt>
                <dd>
                  <ul>
                    {data.links.map((l) => (
                      <li>
                        <a href={l.url}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="prose">
        {data.cover && <img src={data.cover} alt={data.coverAlt ?? ''} class="cover" />}
        <Content />
      </div>
    </div>

    {
      (newer || older) && (
        <nav class="pager" aria-label="More projects">
          {older ? (
            <a href={`/projects/${older.id}/`}>
              <span>Previous</span>
              {older.data.title}
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={`/projects/${newer.id}/`} class="next">
              <span>Next</span>
              {newer.data.title}
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .head {
    padding-top: clamp(2rem, 6vw, 4rem);
    max-width: 52rem;
  }
  .back {
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .back::before {
    content: '\2190\00a0';
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(1.9rem, 4.6vw, 3.1rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .answer {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border-left: 4px solid var(--accent);
    border-radius: 0 6px 6px 0;
    max-width: var(--measure);
  }
  .answer h2 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0;
    margin-bottom: 0.35rem;
  }
  .answer p {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .body {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }
  .facts {
    font-family: var(--font-head);
    font-size: 0.9rem;
  }
  .facts dl {
    margin: 0;
    position: sticky;
    top: 1.5rem;
  }
  .facts div {
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    color: var(--ink-2);
    font-size: 0.8rem;
  }
  .facts dd {
    margin: 0.15rem 0 0;
  }
  .facts ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cover {
    margin-top: 0 !important;
  }
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
  }
  .pager a {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--accent);
  }
  .pager span {
    display: block;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--ink-2);
    margin-bottom: 0.25rem;
  }
  .pager .next {
    text-align: right;
  }

  @media (max-width: 760px) {
    .body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .facts dl {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1.5rem;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
