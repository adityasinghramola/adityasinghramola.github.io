---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap" style="padding-top: clamp(3rem, 10vw, 6rem);">
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.03em;">This page doesn't exist.</h1>
    <p style="margin-top: 1rem; color: var(--ink-2);">
      It may have moved when a project was renamed. <a href="/">See all projects</a>.
    </p>
  </section>
</Base>
