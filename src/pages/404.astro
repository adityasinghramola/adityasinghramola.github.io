---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap" style="padding-top: clamp(3rem, 10vw, 6rem);">
    <h1 style="font-size: clamp(1rem, 3.6vw, 1.6rem); color: var(--pink);">Game over: page not found</h1>
    <p style="margin-top: 1.5rem; color: var(--ink-2);">
      It may have been renamed. <a href="/">Back to the start</a>.
    </p>
  </section>
</Base>
