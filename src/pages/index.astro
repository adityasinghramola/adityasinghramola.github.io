---
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import { getProjects, slugify, formatDate } from '../lib/projects';

const projects = await getProjects();
const topics = [...new Set(projects.flatMap((p) => p.data.topics))].sort();
const done = projects.filter((p) => p.data.status === 'done').length;
const open = projects.length - done;
---

<Base>
  <section class="intro wrap">
    <h1>I take small questions about markets, money and policy, and work them through with data.</h1>
    <p class="lede">
      This is the running list. Some are finished, most are still moving. Each one starts with the question and ends
      with what I found, how, and what I'd check next.
    </p>
  </section>

  <section class="index wrap" aria-labelledby="index-head">
    <div class="index-bar">
      <h2 id="index-head">
        {projects.length} {projects.length === 1 ? 'project' : 'projects'}
        <span class="count">{done} done, {open} in progress</span>
      </h2>
      {
        topics.length > 1 && (
          <div class="filters" role="group" aria-label="Filter by topic">
            <button type="button" data-topic="all" aria-pressed="true">All</button>
            {topics.map((t) => (
              <button type="button" data-topic={slugify(t)} aria-pressed="false">
                {t}
              </button>
            ))}
          </div>
        )
      }
    </div>

    {
      projects.length === 0 ? (
        <p class="empty">No projects published yet. Add one in Pages CMS and it appears here after the next deploy.</p>
      ) : (
        <ol class="rows" reversed>
          {projects.map((p) => (
            <li class="row" data-topics={p.data.topics.map(slugify).join(' ')}>
              <a class="row-link" href={`/projects/${p.id}/`}>
                <span class="row-meta">
                  <Status status={p.data.status} />
                  <time datetime={(p.data.updated ?? p.data.date).toISOString()}>
                    {p.data.updated ? `Updated ${formatDate(p.data.updated)}` : formatDate(p.data.date)}
                  </time>
                </span>
                <span class="row-title">{p.data.title}</span>
                <span class="row-summary">{p.data.summary}</span>
                {p.data.topics.length > 0 && (
                  <span class="row-topics">
                    {p.data.topics.map((t) => (
                      <span class="topic">{t}</span>
                    ))}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      )
    }
    <p class="empty filtered" hidden>Nothing under this topic yet.</p>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const rows = document.querySelectorAll<HTMLElement>('.row');
  const none = document.querySelector<HTMLElement>('.filtered');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const topic = btn.dataset.topic!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      rows.forEach((r) => {
        const match = topic === 'all' || (r.dataset.topics ?? '').split(' ').includes(topic);
        r.hidden = !match;
        if (match) shown++;
      });
      if (none) none.hidden = shown > 0;
    })
  );
</script>

<style>
  .intro {
    padding-top: clamp(3rem, 10vw, 7rem);
    padding-bottom: clamp(2.5rem, 7vw, 4.5rem);
  }
  .intro h1 {
    font-size: clamp(2rem, 5.2vw, 3.6rem);
    font-weight: 600;
    max-width: 20ch;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .lede {
    max-width: 52ch;
    margin-top: 1.5rem;
    font-size: 1.15rem;
    color: var(--ink-2);
  }

  .index-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
  }
  .index-bar h2 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .count {
    font-weight: 400;
    color: var(--ink-2);
    margin-left: 0.6rem;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .filters button {
    font: 500 0.875rem/1 var(--font-head);
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--ink);
    border-color: var(--ink-2);
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    border-bottom: 1px solid var(--rule);
  }
  .row-link {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    column-gap: 2rem;
    row-gap: 0.4rem;
    padding: 1.75rem 0;
    color: inherit;
    text-decoration: none;
  }
  .row-meta {
    grid-row: 1 / span 3;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.45rem;
    font-family: var(--font-head);
    font-size: 0.85rem;
    color: var(--ink-2);
  }
  .row-title {
    font-family: var(--font-head);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 34ch;
    text-wrap: balance;
  }
  .row-link:hover .row-title {
    color: var(--accent);
  }
  .row-link:focus-visible {
    outline-offset: 0;
  }
  .row-summary {
    color: var(--ink-2);
    max-width: 62ch;
  }
  .row-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.35rem;
  }
  .topic {
    font-family: var(--font-head);
    font-size: 0.8rem;
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    background: var(--accent-wash);
    color: var(--ink);
  }
  .empty {
    padding: 2.5rem 0;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .row-link {
      grid-template-columns: 1fr;
    }
    .row-meta {
      grid-row: auto;
      flex-direction: row;
      gap: 1rem;
      padding-top: 0;
    }
  }
</style>
