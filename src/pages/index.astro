---
import Base from '../layouts/Base.astro';
import Orb from '../components/Orb.astro';
import ProjectList from '../components/ProjectList.astro';
import { sections, getProjects, type SectionKey } from '../lib/projects';

const all = await getProjects();
const count = (k: SectionKey) => all.filter((p) => p.data.category === k).length;
---

<Base>
  <section class="start wrap">
    <h1>Aditya Ramola's portfolio</h1>
    <p class="sub">Code, games, art and finance. Pick a section.</p>

    <nav class="menu box" aria-label="Choose a section">
      <ul>
        {
          (Object.keys(sections) as SectionKey[]).map((k) => (
            <li>
              <a href={sections[k].path}>
                <Orb color={sections[k].color} size={24} />
                <span class="name">{sections[k].name}</span>
                <span class="n">{count(k)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <section class="wrap latest" aria-labelledby="latest">
    <h2 id="latest">Latest</h2>
    <ProjectList items={all.slice(0, 6)} empty="Nothing posted yet. The first project goes up soon." />
  </section>
</Base>

<style>
  .start {
    padding-top: clamp(2.5rem, 9vw, 5.5rem);
  }
  h1 {
    font-size: clamp(1.15rem, 4.2vw, 2.25rem);
    line-height: 1.45;
    color: var(--yellow);
    text-shadow: var(--px) var(--px) 0 var(--ink-dark);
    max-width: 18ch;
  }
  .sub {
    margin: 1.25rem 0 2.5rem;
    color: var(--ink-2);
  }

  .menu {
    max-width: 30rem;
    padding: 0.75rem;
  }
  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--pixel);
    font-size: 0.8rem;
  }
  .menu .name {
    flex: 1;
  }
  .menu .n {
    color: var(--ink-2);
  }
  /* The orb is the cursor: dim until the row is pointed at or focused. */
  .menu .orb {
    opacity: 0.35;
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--bg);
    color: var(--yellow);
    outline: none;
  }
  .menu a:hover .orb,
  .menu a:focus-visible .orb {
    opacity: 1;
  }

  .latest {
    margin-top: 4.5rem;
  }
  .latest h2 {
    font-size: 0.85rem;
    padding-bottom: 0.75rem;
    border-bottom: var(--px) solid var(--ink);
  }
</style>
