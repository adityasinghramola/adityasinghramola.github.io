---
interface Props {
  status: 'in-progress' | 'done';
}
const { status } = Astro.props;
const label = status === 'done' ? 'Done' : 'In progress';
---

<span class:list={['status', status]}>
  <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
    {
      status === 'done' ? (
        <circle cx="6" cy="6" r="5" fill="currentColor" />
      ) : (
        <>
          <circle cx="6" cy="6" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M6 1.5 A4.5 4.5 0 0 1 6 10.5 Z" fill="currentColor" />
        </>
      )
    }
  </svg>
  {label}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .status.done {
    color: var(--done);
  }
  .status.in-progress svg {
    color: var(--accent);
  }
</style>
