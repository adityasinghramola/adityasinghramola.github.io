---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="About Aditya Ramola.">
  <section class="wrap page">
    <h1>About</h1>
    <div class="prose">
      <p>
        I'm Aditya Ramola, a finance graduate based in Delhi. This is where I put the things I make: code and games, art,
        and analysis of markets and money.
      </p>
      <p>Some entries are finished and some are still in progress. Each one says which.</p>
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(2rem, 7vw, 4rem);
  }
  h1 {
    font-size: clamp(1rem, 3.6vw, 1.6rem);
    color: var(--yellow);
    margin-bottom: 1.75rem;
  }
</style>
