---
import '@fontsource/press-start-2p/latin-400.css';
import '../styles/global.css';
import fontUrl from '@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url';
import { sections } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
}

const site = "Aditya Ramola's portfolio";
const { title, description = 'Code, games, art and finance analysis by Aditya Ramola.' } = Astro.props;
const pageTitle = title ? `${title} | ${site}` : site;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#1d2b53" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="head wrap">
      <a class="mark" href="/">Aditya Ramola's portfolio</a>
      <nav aria-label="Sections">
        {
          Object.values(sections).map((s) => (
            <a href={s.path} aria-current={path.startsWith(s.path) ? 'page' : undefined} style={`--c:${s.color}`}>
              {s.name}
            </a>
          ))
        }
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined} style="--c:var(--yellow)">About</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap">
      <p class="foot">Plain HTML, no tracking. Built with Astro, hosted on GitHub Pages.</p>
    </footer>
  </body>
</html>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .mark {
    font-family: var(--pixel);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.15rem 0;
    border-bottom: var(--px) solid transparent;
  }
  nav a:hover {
    color: var(--ink);
  }
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--c);
  }
  .foot {
    margin: 6rem 0 0;
    padding: 1.5rem 0 3rem;
    border-top: var(--px) dotted var(--line);
    color: var(--ink-2);
    font-size: 0.875rem;
  }
</style>
